# Public — ship in Expo bundle (RLS is the gate)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Expo env
EXPO_PUBLIC_APP_ENV=development

# Backend only — never commit (supabase/.env)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BREVO_SMTP_USER=xxx
# BREVO_SMTP_PASS=xxx
# FCM_SERVER_KEY=xxx
# AD_SSV_KEY_ADMOB=xxx
# AD_SSV_KEY_UNITY=xxx
# OWNER_BOOTSTRAP_SECRET=xxx
