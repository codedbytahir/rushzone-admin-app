{
  "expo": {
    "name": "Rush Zone Control",
    "slug": "rushzone-admin-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rushzonecontrol",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C140F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1C140F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rushzone.control",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1C140F"
      },
      "package": "com.rushzone.control",
      "blockedPermissions": [],
      "usesCleartextTraffic": false,
      "permissions": [
        "android.permission.NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ED5A1F"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Rush Zone Control to access your photos so you can upload tournament thumbnails and banner images."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
