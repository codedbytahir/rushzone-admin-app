{
  "name": "rushzone-admin-app",
  "version": "0.1.0",
  "description": "Rush Zone Control — Owner & Admin operations app (Expo + Supabase). Foundation ready.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "gen:types": "supabase gen types typescript --local > types/database.types.ts",
    "supabase:start": "supabase start",
    "supabase:db:reset": "supabase db reset",
    "supabase:functions:serve": "supabase functions serve --env-file ./supabase/.env --debug",
    "e2e": "echo 'No E2E yet'"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.45.0",
    "aes-js": "^3.1.2",
    "expo": "~51.0.28",
    "expo-constants": "~16.0.2",
    "expo-crypto": "~13.0.2",
    "expo-image-manipulator": "~12.0.5",
    "expo-linking": "~6.3.1",
    "expo-notifications": "~0.28.19",
    "expo-router": "~3.5.23",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-get-random-values": "~1.11.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.19.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/aes-js": "^3.1.1",
    "@types/react": "~18.2.79",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^8.57.0",
    "supabase": "^1.200.0",
    "typescript": "^5.3.3"
  },
  "private": true
}
